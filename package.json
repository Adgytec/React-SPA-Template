{
    "name": "react-spa-template",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "sync-translation": "tsx scripts/sync-i18n.ts",
        "dev": "npm run sync-translation && vite",
        "lint": "biome check .",
