        "@types/react-transition-group": "^4.4.12",
        "clsx": "^2.1.1",
        "i18next": "^26.3.4",
        "i18next-browser-languagedetector": "^8.2.1",
        "i18next-http-backend": "^4.0.0",
        "lucide-react": "^1.23.0",
        "react": "^19.2.7",
        "react-aria": "^3.50.0",
        "react-aria-components": "^1.19.0",
        "react-dom": "^19.2.7",
        "react-i18next": "^17.0.8",
        "react-transition-group": "^4.4.5",
        "url-join": "^5.0.0",
