        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.3",
        "autoprefixer": "^10.5.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "dotenv": "^17.4.2",
        "globals": "^17.7.0",
        "postcss": "^8.5.16",
        "postcss-nesting": "^14.0.0",
